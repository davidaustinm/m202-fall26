<diagram xmlns="https://prefigure.org"
         dimensions="(250,250)" margins="5">
  <definition>p(t)=1/2*exp(-t/2)</definition>
  <definition>q(t)=1/4*exp(-t/4)</definition>
  <coordinates bbox="(-1,-0.2, 6, 0.7)">
    <grid-axes xlabel="t"/>
    <graph function="p" domain="(0,6)"/>
    <graph function="q" domain="(0,6)"/>
    <label anchor="(0.3,p(0.3))" alignment="ne">
      <m>p_1(t)</m>
    </label>
    <label anchor="(4,q(4))" alignment="ne">
      <m>p_2(t)</m>
    </label>
  </coordinates>
</diagram>
