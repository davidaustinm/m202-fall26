<prefigure xmlns="https://prefigure.org"
           label="25-slope-5-sol">
  <diagram dimensions="(320,200)" margins="5">
    <definition>f(y)=-1/2*y*(y-4)</definition>
    <coordinates bbox="(-2,-2.5,6,2.5)">
      <grid-axes spacings="((-2,1,6),(-3,1,3))"
                 xlabel="y" ylabel="\frac{dy}{dt}"/>
      <graph function="f"/>
    </coordinates>
  </diagram>
</prefigure>
