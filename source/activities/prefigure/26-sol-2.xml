<prefigure xmlns="https://prefigure.org"
           label="26-sol-2">
  <diagram dimensions="(300,300)" margins="(35,5,5,5)">
    <definition>f(t,y)=1/2*(4*y-y^2)</definition>
    <coordinates bbox="(0,-1,6,5)">
      <grid-axes decorations="no" vlabels="(-1,1,5)"/>
      <slope-field function="f"/>
      <plot-de-solution function="f" t0="0" t1="bbox[2]" y0="1"
                        stroke="orange"/>
    </coordinates>
  </diagram>
</prefigure>
