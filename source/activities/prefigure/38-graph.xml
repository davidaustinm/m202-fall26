<prefigure xmlns="https://prefigure.org"
           label="38-graph">
  <diagram dimensions="(300,300)" margins="5">
    <definition>f(x)=4*x-x^3</definition>
    <coordinates bbox="(-3,-4,3,4)">
      <grid-axes ylabel="\frac{dy}{dt}" xlabel="y" decorations="no" 
                 hlabels="(0,5,15)" border="yes"/>
      <graph function="f"/>
    </coordinates>
  </diagram>
</prefigure>
