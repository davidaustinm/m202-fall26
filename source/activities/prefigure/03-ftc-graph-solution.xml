<diagram xmlns="https://prefigure.org"
         dimensions="(250, 250)" margins="5">
  <definition>f1(x)=x^2-1</definition>
  <definition>f2(x)=f1(1)-1/4*(4-2*x)^2+1</definition>
  <definition>f3(x)=f2(3)+1/2*(x-5)^2-2</definition>
  <definition>f4(x)=f3(6)-1/2*(7-x)^2+1/2</definition>
  <coordinates bbox="(-1,-4,7,4)">
    <grid-axes/>
    <path start="(0,-1)" stroke="blue">
      <graph function="f1" domain="(0,1)"/>
      <graph function="f2" domain="(1,3)"/>
      <graph function="f3" domain="(3,6)"/>
      <graph function="f4" domain="(6,7)"/>
    </path>
  </coordinates>
</diagram>
