<?xml version="1.0" encoding="UTF-8"?>
<worksheet xmlns:xi="http://www.w3.org/2001/XInclude">
  <title>Second Fundamental Theorem of Calculus, part II (Section 5.2)</title>

  <exercise>
    <introduction>
      <p>
        Suppose that
        <md>
          f(t) = \frac t{1+t^2}.
        </md>
      </p>
    </introduction>
    <task>
      <statement>
        <p>
          Using Desmos, sketch the graph of <m>f</m> on the
          interval <m>-5\leq t \leq 5</m> below on the left.
          Then sketch a graph of <m>f'</m> on the right.
        </p>
        <sidebyside widths="45% 45%" margins="0% 0%">
          <image>
            <shordescription>
              An empty coordinate grid
            </shordescription>
            <prefigure xmlns="https://prefigure.org"
                       label="04-empty-t-a">
              <xi:include href="prefigure/04-empty-1.xml"/>
            </prefigure>
          </image>
          <image>
            <shordescription>
              An empty coordinate grid
            </shordescription>
            <prefigure xmlns="https://prefigure.org"
                       label="04-empty-t-b">
              <xi:include href="prefigure/04-empty-1.xml"/>
            </prefigure>
          </image>
        </sidebyside>
      </statement>
      <solution component="04-solutions">
        <sidebyside widths="45% 45%" margins="0% 0%">
          <image>
            <shordescription>
              A graph of f
            </shordescription>
            <prefigure xmlns="https://prefigure.org"
                       label="04-solution-a">
              <xi:include href="prefigure/04-solution-1.xml"/>
            </prefigure>
          </image>
          <image>
            <shordescription>
              The derivative of f
            </shordescription>
            <prefigure xmlns="https://prefigure.org"
                       label="04-solution-b">
              <xi:include href="prefigure/04-solution-2.xml"/>
            </prefigure>
          </image>
        </sidebyside>
      </solution>
    </task>
    <task workspace="0.5in">
      <statement>
        <p>
          Next we'll define
          <md>
            F(x) = \int_0^x f(t)~dt
          </md>.
        </p>
        <p>
          What does the Second Fundamental Theorem of Calculus
          tell us about the relationship between <m>F</m> and
          <m>f</m>?
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          We know that <m>F' = f</m>.
        </p>
      </solution>
    </task>
    <task workspace="0.5in">
      <statement>
        <p>
          Given the graphs you created above, on what intervals
          is <m>F</m> increasing and on what intervals is it
          decreasing?
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>F</m> is increasing when <m>F'=f</m> is positive, which
          happens when <m>x\gt 0</m>.  It is decreasing when <m>x\lt
          0</m>.
        </p>
      </solution>
    </task>
    <task workspace="0.5in">
      <statement>
        <p>
          Given the graphs you created above, on what intervals
          is <m>F</m> concave up and on what intervals is it
          concave down?
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>F</m> is concave up when <m>F''=f'</m> is positive so
          when <m>-1\lt x\lt 1</m>, and it is concave down when
          <m>x\lt -1</m> and <m>x\gt 1</m>.
        </p>
      </solution>
    </task>
    <task workspace="0.5in">
      <statement>
        <p>
          At what points does <m>F</m> have a relative maximum
          or minimum and what is the value of <m>F</m> at these
          points?
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>F</m> has a relative minimum when <m>F'=f=0</m>, which
          occurs at <m>x=0</m>.  We have
          <md>
            F(0)=\int_0^0 f(t)~dt = 0
          </md>.
        </p>
      </solution>
    </task>
    <task workspace="0.5in">
      <statement>
        <p>
          Using Desmos, find the values <m>F(-3)</m>,
          <m>F(-1)</m>, <m>F(1)</m>, and <m>F(3)</m>.
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <ul>
            <li>
              <p><m>F(-3)=1.15</m></p>
            </li>
            <li>
              <p><m>F(-1)=0.347</m></p>
            </li>
            <li>
              <p><m>F(1)=0.347</m></p>
            </li>
            <li>
              <p><m>F(3)=1.15</m></p>
            </li>
          </ul>
        </p>
      </solution>
    </task>
    <task>
      <statement>
        <p>
          Use all the information you've gathered to sketch a
          graph of <m>F</m> below.
        </p>
        <image width="50%">
          <shordescription>
            An empty coordinate grid
          </shordescription>
          <prefigure xmlns="https://prefigure.org"
                     label="04-empty-t-4">
            <xi:include href="prefigure/04-empty-1.xml"/>
          </prefigure>
        </image>

      </statement>
      <solution component="04-solutions">
        <image width="60%">
          <shordescription>
            The graph of F
          </shordescription>
          <prefigure xmlns="https://prefigure.org"
                     label="04-solution-3">
            <xi:include href="prefigure/04-solution-3.xml"/>
          </prefigure>
        </image>
      </solution>
    </task>
  </exercise>

  <exercise>
    <statement>
      <p>
        <term>Differentiation:</term> Complete the table of
        derivatives below.  Feel free to ask someone around you.
      </p>
      <tabular>
        <col halign="center" right="minor"/>
        <col halign="center"/>
        <row bottom="minor">
          <cell><m>f(x)</m></cell>
          <cell><m>f'(x)</m></cell>
        </row>
        <row>
          <cell><m>x</m></cell>
          <cell><m>\hphantom{\Huge MMM}</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>x^n</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\sin x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\cos x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>e^x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\ln x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\arctan x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\arcsin x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
      </tabular>
    </statement>
    <solution component="04-solutions">
      <tabular>
        <col halign="center" right="minor"/>
        <col halign="center"/>
        <row bottom="minor">
          <cell><m>f(x)</m></cell>
          <cell><m>f'(x)</m></cell>
        </row>
        <row bottom="minor">
          <cell><m>x</m></cell>
          <cell><m>1</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>x^n</m></cell>
          <cell><m>nx^{n-1}</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\sin x</m></cell>
          <cell><m>\cos x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\cos x</m></cell>
          <cell><m>-\sin x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>e^x</m></cell>
          <cell><m>e^x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\ln x</m></cell>
          <cell><m>1/x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\arctan x</m></cell>
          <cell><m>1/(1+x^2)</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\arcsin x</m></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell></cell>
          <cell><m>1/\sqrt{1-x^2}</m></cell>
        </row>
      </tabular>
    </solution>
  </exercise>

  <exercise>
    <statement>
      <p>
        <term>Antidifferentiation:</term> Given below is a table
        of functions.  Complete the table by supplying an
        <em>anti</em>derivative of each function.
      </p>
      <tabular>
        <col halign="center" right="minor"/>
        <col halign="center"/>
        <row bottom="minor">
          <cell><m>f(x)</m></cell>
          <cell><m>F(x)</m></cell>
        </row>
        <row>
          <cell><m>x</m></cell>
          <cell><m>\hphantom{\Huge MMM}</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>x^n</m> (<m>n\neq-1</m>)</cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>1/x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\sin x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>\cos x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>e^x</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>1/(1+x^2)</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row>
          <cell><m>1/\sqrt{1-x^2}</m></cell>
          <cell></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
      </tabular>
    </statement>
    <solution component="04-solutions">
      <tabular>
        <col halign="center" right="minor"/>
        <col halign="center"/>
        <row bottom="major">
          <cell><m>f(x)</m></cell>
          <cell><m>F(x)</m></cell>
        </row>
        <row bottom="minor">
          <cell><m>x</m></cell>
          <cell><m>\frac12 x^2</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>x^n</m> (<m>n\neq-1</m>)</cell>
          <cell><m>\frac{1}{n+1}x^{n+1}</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>1/x</m></cell>
          <cell><m>\ln|x|</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\sin x</m></cell>
          <cell><m>-\cos x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>\cos x</m></cell>
          <cell><m>\sin x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>e^x</m></cell>
          <cell><m>e^x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>1/(1+x^2)</m></cell>
          <cell><m>\arctan x</m></cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
        <row bottom="minor">
          <cell><m>1/\sqrt{1-x^2}</m></cell>
          <cell>\arcsin x</cell>
        </row>
        <row>
          <cell></cell>
          <cell></cell>
        </row>
      </tabular>
    </solution>
  </exercise>

  <exercise>
    <introduction>
      <p>
        We would like to use our table to antidifferentiate more
        functions.
      </p>
    </introduction>
    <task workspace="0.75in">
      <statement>
        <p>Find the derivative of <m>f(x) = \cos(3x)</m>.</p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>f'(x)=-3\sin(3x)</m>
        </p>
      </solution>
    </task>
    <task workspace="0.75in">
      <statement>
        <p>
          Using this result, find an expression for an
          antiderivative of <m>\sin(3x)</m>.  You may want to
          make a guess, check if it is correct by
          differentiating, and then making a better guess if
          it's not.
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>-\frac13 \cos(3x)</m>
        </p>
      </solution>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Antidifferentiating is the process of reversing
        differentiation.
      </p>
    </introduction>
    <task workspace="0.75in">
      <statement>
        <p>Find the derivative of <m>g(x) = e^{x^2}</m>.</p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>g'(x)=2xe^{x^2}</m>
        </p>
      </solution>
    </task>
    <task workspace="0.75in">
      <statement>
        <p>
          Using this result, find an expression for an
          antiderivative of <m>xe^{x^2}</m>.
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>\frac12 e^{x^2}</m>
        </p>
      </solution>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Let's do the same thing with a different function.
      </p>
    </introduction>
    <task workspace="1in">
      <statement>
        <p>Find the derivative of <m>h(t) = \ln(1+t^2)</m>.</p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>h'(t)=\frac{2t}{1+t^2}</m>
        </p>
      </solution>
    </task>
    <task workspace="1in">
      <statement>
        <p>
          Now find an expression for an antiderivative of
          <m>\frac{t}{1+t^2}</m>.
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>\frac12 \ln|1+t^2|</m>
        </p>
      </solution>
    </task>
    <task workspace="1in">
      <statement>
        <p>
          Notice that we considered the function
          <m>f(t) = \frac{t}{1+t^2}</m> in the first problem of
          this activity.  Use Desmos to graph your antiderivative
          of <m>f(t)</m> and compare it to your graph of
          <m>F(x)</m>, the antiderivative that you found in that
          problem.
        </p>
      </statement>
      <solution component="04-solutions">
        <p>
          Looks about the same!
        </p>
      </solution>
    </task>
  </exercise>

  <exercise>
    <introduction>
      <p>
        Let's review how the Chain Rule works.
      </p>
    </introduction>
    <task workspace="0.75in">
      <statement>
        <p><m>\displaystyle (x^3 + 2)^2</m></p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>2(x^3+2)\cdot 3x^2</m>
        </p>
      </solution>
    </task>
    <task workspace="0.75in">
      <statement>
        <p><m>\displaystyle \sqrt{e^x + e^{-x}}</m></p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>\frac12\frac{1}{\sqrt{e^x+e^{-x}}}(e^x-e^{-x})</m>
        </p>
      </solution>
    </task>
    <task workspace="0.75in">
      <statement>
        <p><m>\displaystyle \sin^2(3x-5)=(\sin(3x-5))^2</m></p>
      </statement>
      <solution component="04-solutions">
        <p>
          <m>2\sin(3x-5)(\cos(3x-5)\cdot 3)</m>
        </p>
      </solution>
    </task>
  </exercise>

</worksheet>
