<?xml version="1.0" encoding="UTF-8"?>
<worksheet>
  <title>Antidifferentiation Practice</title>

  <!--
  <exercise workspace="1.85in">
    <statement>
      <p>
        <m>\displaystyle \int\frac{1}{t^2 - 1}~dt</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Using partial fractions,
        <m>\frac{1}{t^2-1} = \frac{1/2}{t-1} - \frac{1/2}{t+1}</m>,
        so
        <md>
          \int\frac{1}{t^2-1}~dt =
          \frac{1}{2}\ln\left|\frac{t-1}{t+1}\right| + C.
        </md>
      </p>
    </solution>
  </exercise>
  -->
  
  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int \frac{x}{x^2 - 1}~dx</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Substituting <m>u = x^2-1</m>,
        <md>
          \int\frac{x}{x^2-1}~dx = \frac{1}{2}\ln|x^2-1| + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int x\cos x~dx</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Integration by parts with <m>u = x</m>,
        <m>dv = \cos x~dx</m>:
        <md>
          \int x\cos x~dx = x\sin x + \cos x + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int x^2(2x^3 - 1)^3~dx</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Substituting <m>u = 2x^3-1</m>,
        <md>
          \int x^2(2x^3-1)^3~dx = \frac{(2x^3-1)^4}{24} + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int\frac{1}{1+t^2}~dt</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        <md>
          \int\frac{1}{1+t^2}~dt = \arctan t + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int z^2 e^{2z}~dz</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Applying integration by parts twice,
        <md>
          \int z^2 e^{2z}~dz =
          \frac{e^{2z}}{4}(2z^2 - 2z + 1) + C.
        </md>
      </p>
    </solution>
  </exercise>

  <!--
  <exercise workspace="2in">
    <statement>
      <p>
        <m>\displaystyle \int \frac{1}{x^2-x}~dx</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Using partial fractions,
        <m>\frac{1}{x^2-x} = \frac{-1}{x} + \frac{1}{x-1}</m>,
        so
        <md>
          \int\frac{1}{x^2-x}~dx =
          \ln\left|\frac{x-1}{x}\right| + C.
        </md>
      </p>
    </solution>
  </exercise>
  -->
  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int \ln x~dx</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Integration by parts with <m>u = \ln x</m>, <m>dv = dx</m>:
        <md>
          \int \ln x~dx = x\ln x - x + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int\frac{e^{2x}}{e^{2x} + 1}~dx</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Substituting <m>u = e^{2x}+1</m>,
        <md>
          \int\frac{e^{2x}}{e^{2x}+1}~dx =
          \frac{1}{2}\ln(e^{2x}+1) + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int t\ln t~dt</m>
      </p>
    </statement>
    <solution component="09">
      <p>
        Integration by parts with <m>u = \ln t</m>,
        <m>dv = t~dt</m>:
        <md>
          \int t\ln t~dt = \frac{t^2}{4}(2\ln t - 1) + C.
        </md>
      </p>
    </solution>
  </exercise>

  <exercise workspace="1.5in">
    <statement>
      <p>
        <m>\displaystyle \int \cos^2(\theta)\sin(\theta)~d\theta</m>
        remember that <m>\cos^2(\theta)</m> is a shorthand for
        <m>(\cos(\theta))^2</m>.
      </p>
    </statement>
    <solution component="09">
      <p>
        Substituting <m>u = \cos\theta</m>,
        <md>
          \int \cos^2\theta\sin\theta~d\theta =
          -\frac{\cos^3\theta}{3} + C.
        </md>
      </p>
    </solution>
  </exercise>

</worksheet>
