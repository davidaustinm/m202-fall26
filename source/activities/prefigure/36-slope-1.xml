<prefigure xmlns="https://prefigure.org"
           label="36-slope-1">
  <diagram dimensions="(300,300)" margins="5">
    <definition>f(t,x)=1/10*x*(8-x)</definition>
    <coordinates bbox="(-1,-1,10,10)">
      <grid-axes ylabel="y" xlabel="t" border="yes"/>
      <slope-field function="f"/>
    </coordinates>
  </diagram>
</prefigure>
