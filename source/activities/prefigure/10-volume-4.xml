<diagram xmlns="https://prefigure.org"
         dimensions="(250,250)" margins="5">
  <definition>f(x)=4-(x-1)^2</definition>
  <coordinates bbox="(-0.5,-1.5,4.5,3.5)">
    <grid spacings="((-1,1,5),(-2,1,4))"/>
    <transform>
      <change-basis basis="((0,1),(1,0))"/>
      <area-under-curve function="f"
                        fill="lightgray" stroke="black"
                        domain="(-1,3)"/>
    </transform>
    <axes xlabel="x" ylabel="y"/>
  </coordinates>
</diagram>
               
